{
  "name": "@pq402/examples",
  "version": "0.2.0",
  "private": true,
  "description": "A paid PQ-402 endpoint, a client that pays it, and the testnet setup script.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "server": "tsx --env-file-if-exists=../.env server.ts",
    "client": "tsx --env-file-if-exists=../.env client.ts",
