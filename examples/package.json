    "typecheck": "tsc --noEmit",
    "demo": "tsx --env-file-if-exists=../.env demo.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@pq402/client": "workspace:*",
    "@pq402/core": "workspace:*",
    "@pq402/scheme-qorechain": "workspace:*",
    "@pq402/server": "workspace:*",
    "@qorechain/evm": "0.14.0",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/sdk": "0.14.0",
    "viem": "^2.40.0",
    "@x402/core": "2.31.0"
  }
}
