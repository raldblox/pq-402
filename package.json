{
  "name": "pq-402",
  "version": "0.1.1",
  "private": true,
  "description": "A post-quantum extension of the x402 HTTP payment protocol for QoreChain: ML-DSA-87 signed payments, ML-KEM-1024 sealed bodies.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:server": "pnpm --filter @pq402/examples run server",
    "example:client": "pnpm --filter @pq402/examples run client",
    "testnet": "pnpm --filter @pq402/examples run testnet",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:fmt:check": "forge fmt --root contracts --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
