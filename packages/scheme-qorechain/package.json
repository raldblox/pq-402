    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pq402/core": "workspace:*",
    "@qorechain/qoreseal": "0.1.0",
    "@x402/core": "2.31.0",
    "viem": "^2.40.0"
