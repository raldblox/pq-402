{
  "name": "@pq402/scheme-qorechain",
  "version": "0.2.1",
  "description": "The PQ-402 pq-erc20 x402 scheme for QoreChain: client, resource server and facilitator plugins for @x402/core, and chain adapters.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raldblox/pq-402.git",
    "directory": "packages/scheme-qorechain"
  },
  "keywords": [
    "x402",
    "post-quantum",
    "ml-dsa",
    "qorechain",
    "payments",
    "facilitator"
  ],
  "exports": {
