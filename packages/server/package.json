{
  "name": "@pq-402/server",
  "version": "0.1.1",
  "description": "PQ-402 resource server: a framework-agnostic payment gate that answers 402, verifies ML-DSA-87 payments, settles them and seals responses with ML-KEM-1024, plus a node:http adapter.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raldblox/pq-402.git",
    "directory": "packages/server"
  },
  "keywords": [
    "x402",
    "post-quantum",
    "middleware",
    "ml-kem",
    "qorechain",
    "payments"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pq-402/core": "workspace:*",
    "@pq-402/scheme-qorechain": "workspace:*",
    "@x402/core": "2.31.0",
    "viem": "^2.40.0"
  }
}
