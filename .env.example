# Copy to .env (git-ignored), or let `pnpm testnet keys` write a fresh one.
# These are throwaway testnet accounts: never reuse a phrase that holds anything else.

# BIP-39 phrase of the gateway: serves the paid endpoint, deploys the escrow,
# relays settlements (pays their gas) and signs receipts.
GATEWAY_MNEMONIC=

# BIP-39 phrase of the payer (the agent): signs payments, opens sealed answers.
PAYER_MNEMONIC=

# PQ402Escrow address, after `pnpm testnet deploy --broadcast`.
ESCROW_ADDRESS=

# Optional: pay from a Perennial v2 position. The payer must be its beneficiary.
PERENNIAL_VAULT=
PERENNIAL_POSITION=

# Optional deploy settings (defaults: testnet fUSD, 3600 seconds).
# ESCROW_ASSET=
# WITHDRAWAL_DELAY=
